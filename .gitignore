# ---------------------------------------------------------------------------
# Secrets and credentials - never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
secrets.json
credentials.json
*.secret
secrets/
credentials/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# Python build and cache artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# Test and tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/

# ---------------------------------------------------------------------------
# Generated scan artifacts - regenerate with `python -m bcssl run-all`
# ---------------------------------------------------------------------------
# Verbatim tool output, normalized findings, reports, evidence records and the
# run index / assessment manifests are all derived data. Evidence hashes must be
# reproducible from a fresh run, so they are not version controlled.
reports/raw/*
reports/normalized/*
reports/final/*
evidence/*
state/*
# ...but keep the directory skeleton.
!reports/raw/.gitkeep
!reports/normalized/.gitkeep
!reports/final/.gitkeep
!evidence/.gitkeep
!state/.gitkeep
!reports/**/.gitkeep
!evidence/**/.gitkeep

# ---------------------------------------------------------------------------
# Nuclei templates - data, not source
# Re-fetch with: python -m bcssl update-templates && python -m bcssl build-template-profile
# ---------------------------------------------------------------------------
tools/nuclei/templates/
tools/nuclei/templates-lab/

# ---------------------------------------------------------------------------
# Docker runtime data
# ---------------------------------------------------------------------------
docker-compose.override.yml
*.dockerfile
.docker/

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.old
*.orig
*.swp
*~
~$*
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Editor and IDE state
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------------------------
# OS and personal files
# ---------------------------------------------------------------------------
*.lnk
Thumbs.db
.DS_Store
Desktop.ini
nohup.out

# ---------------------------------------------------------------------------
# Release packages must never be committed inside the project
# ---------------------------------------------------------------------------
*-RELEASE/